#!/usr/bin/env python3
"""Generate Synapse installer icons (no third-party deps).

Design: dark rounded-square tile + green "dot" blob with two diamond eyes
(matches the default agent avatar in docs/PRD.md and docs/UI.md).
Writes 512px and 256px RGBA PNGs into assets/icons/.
"""
import math
import os
import struct
import sys
import zlib

OUT = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "assets", "icons"
)
# When run from the repo root via `python3 scripts/gen-icons`, __file__ is scripts/gen-icons.
REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "assets", "icons")


def rounded_rect(x, y, size, radius):
    def inside(px, py):
        cx = min(max(px, radius), size - radius)
        cy = min(max(py, radius), size - radius)
        return (px - cx) ** 2 + (py - cy) ** 2 <= radius**2

    return inside


def draw(size):
    s = size
    bg = (26, 34, 51, 255)  # dark slate tile
    blob = (61, 220, 132, 255)  # synapse green
    eye = (16, 24, 20, 255)
    shine = (255, 255, 255, 60)

    cx, cy = s / 2, s / 2 + s * 0.03
    rx, ry = s * 0.30, s * 0.345  # bean blob radii
    tile = rounded_rect(0, 0, s, s * 0.225)

    # diamond eyes (rotated squares)
    eye_r = s * 0.052
    eye_y = cy - s * 0.045
    eye_dx = s * 0.115

    def diamond(px, py, ex):
        return abs(px - ex) + abs(py - eye_y) <= eye_r

    # highlight blob on the blob's upper-left
    hl_cx, hl_cy, hl_r = cx - rx * 0.38, cy - ry * 0.42, s * 0.055

    rows = bytearray()
    for py in range(s):
        rows.append(0)  # filter byte: None
        for px in range(s):
            fx, fy = px + 0.5, py + 0.5
            if not tile(px, py):
                rows.extend((0, 0, 0, 0))
                continue
            ex = ((fx - cx) / rx) ** 2 + ((fy - cy) / ry) ** 2
            if ex <= 1.0:
                # soft edge
                edge = min(1.0, (1.0 - ex) * s * 0.02 + 0.55)
                r, g, b, a = blob
                if diamond(fx, fy, cx - eye_dx) or diamond(fx, fy, cx + eye_dx):
                    r, g, b = eye[:3]
                hx, hy = fx - hl_cx, fy - hl_cy
                if hx * hx + hy * hy <= hl_r * hl_r:
                    r, g, b = (
                        min(255, int(r * 0.35 + 255 * 0.65)),
                        min(255, int(g * 0.35 + 255 * 0.65)),
                        min(255, int(b * 0.35 + 255 * 0.65)),
                    )
                rows.extend((r, g, b, int(a * min(1.0, edge + 0.45))))
            else:
                rows.extend(bg)
    return bytes(rows)


def write_png(path, size, pixels):
    def chunk(typ, data):
        c = struct.pack(">I", len(data)) + typ + data
        return c + struct.pack(">I", zlib.crc32(typ + data) & 0xFFFFFFFF)

    ihdr = struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)
    raw = zlib.compress(bytes(pixels), 9)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", ihdr))
        f.write(chunk(b"IDAT", raw))
        f.write(chunk(b"IEND", b""))


def main():
    os.makedirs(OUT, exist_ok=True)
    for size in (512, 256):
        path = os.path.join(OUT, f"icon-{size}.png")
        write_png(path, size, draw(size))
        print(f"wrote {path}")


if __name__ == "__main__":
    sys.exit(main())
